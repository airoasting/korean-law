{
  "name": "korean-law",
  "version": "1.3.0",
  "private": true,
  "description": "법률 문서의 조문·판례 인용을 법제처 국가법령정보센터 Open API로 검증하는 MCP 서버 (korean-law 스킬 엔진)",
  "type": "module",
  "bin": {
    "korean-law": "build/server.js"
  },
  "main": "build/server.js",
  "scripts": {
    "build": "rm -rf build && tsc",
    "start": "node build/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "aliases": "npm run build && node scripts/build-law-aliases.mjs",
    "bundle": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.mjs --legal-comments=none --minify --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\""
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
